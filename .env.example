# 이 파일을 .env.local로 복사해 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
#   cp .env.example .env.local
# 배포(Vercel)에서는 Project Settings > Environment Variables에 같은 이름으로 넣고 다시 배포합니다.

# [필수] Anthropic API 키 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# [선택] 모델을 직접 지정합니다. 비우면 로컬은 claude-haiku-4-5, 실제 배포는 claude-opus-5-5를 씁니다.
# CHAT_MODEL=claude-haiku-4-5
